APP_NAME=ViloCare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://vilocare.infinityfree.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=YOUR_INFINITYFREE_DB_HOST
DB_PORT=3306
DB_DATABASE=YOUR_INFINITYFREE_DB_NAME
DB_USERNAME=YOUR_INFINITYFREE_DB_USER
DB_PASSWORD=YOUR_INFINITYFREE_DB_PASSWORD
DB_CONNECT_TIMEOUT=10

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_LOG_CHANNEL=stack
MAIL_SCHEME=tls
MAIL_ENCRYPTION=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="ViloCare Team"

AUTH_PASSWORD_RESET_TOKEN_EXPIRE=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

AFRICASTALKING_BASE_URL=https://api.africastalking.com
AFRICASTALKING_SANDBOX_BASE_URL=https://api.sandbox.africastalking.com
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=
AFRICASTALKING_SANDBOX=false

VILOCARE_SMS_DRIVER=auto
VILOCARE_APPOINTMENT_REMINDER_DAYS_BEFORE=1

VILOCARE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses

OLLAMA_BASE_URL=
OLLAMA_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL="${APP_URL}"
OPENROUTER_APP_NAME="${APP_NAME}"

VILOCARE_ALERT_EMAILS=
VILOCARE_ALERT_SMS=

RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

MTN_MOMO_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=
MTN_MOMO_CALLBACK_URL=${APP_URL}/payments/mtn/callback
MTN_MOMO_TIMEOUT=30

VILOCARE_SIMULATE_PAYMENT_GATEWAYS=false

VITE_APP_NAME="${APP_NAME}"
